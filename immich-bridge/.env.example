# Immich bridge — environment template
# Copy to .env and fill in values for the local Immich deployment.
# This file is committed as a template; do NOT commit a populated .env.

# --- Immich Postgres ---
IMMICH_DB_HOST=127.0.0.1
IMMICH_DB_PORT=5432
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=replace-me

# Filesystem path Immich uses for original uploads. Usually /usr/src/app/upload
# inside the Immich container; on the host it's whatever you bind-mounted.
UPLOAD_LOCATION=/usr/src/app/upload

# --- Pool rotation ---
IMMICH_POOL_SIZE=100
# 0 = only refresh when the pool drains. >0 = also refresh periodically.
IMMICH_POOL_REFRESH_SECONDS=0

# --- Bridge HTTP server ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8090

# --- Optional: skip the database and serve a single test image forever ---
# Useful for firmware bring-up. Leave unset in production.
# BRIDGE_FIXTURE_PATH=/path/to/test.jpg

LOG_LEVEL=INFO